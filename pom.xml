<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>net.java21.data2flow</groupId>
    <artifactId>data2flow-pipeline</artifactId>
    <version>${revision}</version>
    <name>data2flow-pipeline</name>
    <description>디코딩, DECODE·TRANSFORM 스크립트(GraalJS), 기기 식별·자동 등록, 검증, 저장, 집계·파티션 관리 (ING, SCR, TSD)</description>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <!-- 보안 패치(2026-10-03 Trivy): Boot 기본값의 취약 버전을 고친 버전으로 올린다. Boot 다음 패치가 같은 버전 이상을 담으면 지운다
             tomcat 11.0.24 → CVE-2026-65182·65905·68525(CRITICAL), jackson 3.1.5 → CVE-2026-89407·89425·68497·91776·91777(HIGH) -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <data2flow-contracts.version>0.1.0-SNAPSHOT</data2flow-contracts.version>
        <!-- ShedLock(Apache-2.0, design/oss-stack.md): 시계열 유지·오프라인 판정 스케줄 작업의 작업 단위 리더 -->
        <shedlock.version>7.10.1</shedlock.version>
    </properties>

    <!-- data2flow-contracts·data2flow-bom은 GitHub Packages에 있다. 읽기에도 토큰이 필요하다(README 참고) -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/data2flow/data2flow-contracts</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.java21.data2flow</groupId>
                <artifactId>data2flow-bom</artifactId>
                <version>${data2flow-contracts.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 기준 저장소: PostgreSQL 18, 스키마 data2flow_pipeline(ADR-019). 월 파티션은 우리 스케줄러가 관리(pg_partman 없음) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- RabbitMQ(ADR-020): 도메인 이벤트(data2flow.events)·설정 변경(data2flow.config)은 AMQP,
             data2flow.raw·data2flow.telemetry Super Stream은 Stream Java Client(Apache-2.0/MPL-2.0, 버전은 Boot 관리) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>stream-client</artifactId>
        </dependency>
        <!-- 사용자 스크립트 샌드박스: 공용 모듈(ADR-046). GraalJS 커뮤니티판(polyglot + js-community, UPL)을 함께 가져온다.
             org.graalvm.polyglot:js(Oracle판, GFTC)는 금지(ADR-008, 아래 enforcer). 버전은 data2flow-bom -->
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-script-sandbox</artifactId>
        </dependency>
        <!-- 분산 추적(OPS-02.03): Micrometer Tracing + OpenTelemetry. ingress → pipeline을 하나의 추적으로 잇는다(traceparent).
             내보내기 주소를 설정한 환경에서만 내보낸다. Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <!-- 기기·측정 항목 캐시(Apache-2.0, 버전은 Boot 관리) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.java21.data2flow</groupId>
            <artifactId>data2flow-contracts-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- *IT: 실제 PostgreSQL 18·RabbitMQ 3.13 Stream(Testcontainers, H2 금지). 실제 s3·s4 인프라에는 붙지 않는다 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 라이선스 정책(ADR-008·018): GraalJS Oracle판(GFTC)·enterprise·isolate 런타임 금지 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-non-community-graal</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.graalvm.polyglot:js</exclude>
                                        <exclude>org.graalvm.polyglot:js-isolate</exclude>
                                        <exclude>org.graalvm.truffle:truffle-enterprise</exclude>
                                        <exclude>org.graalvm.polyglot:*-isolate</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- *IT는 failsafe로 verify 단계에서 실행(design/testing) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
                </executions>
            </plugin>
            <!-- 커버리지 80% 강제. 단위·통합 테스트 결과를 합쳐서 본다 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes><exclude>**/*Application.class</exclude></excludes>
                </configuration>
                <executions>
                    <!-- 에이전트는 GraalJS·Truffle(제3자, 보고서 대상 아님)을 계측하지 않는다. 계측하면 해석 실행 경로가 2배쯤 느려져
                         스크립트 CPU 50ms 한도 시험이 운영과 다른 조건에서 돈다(SCR-02.02) -->
                    <execution><id>prepare</id><goals><goal>prepare-agent</goal></goals>
                        <configuration><excludes><exclude>com.oracle.*</exclude><exclude>org.graalvm.*</exclude></excludes></configuration>
                    </execution>
                    <execution><id>prepare-it</id><goals><goal>prepare-agent-integration</goal></goals>
                        <configuration><excludes><exclude>com.oracle.*</exclude><exclude>org.graalvm.*</exclude></excludes></configuration>
                    </execution>
                    <execution>
                        <id>merge</id><phase>post-integration-test</phase><goals><goal>merge</goal></goals>
                        <configuration>
                            <fileSets><fileSet><directory>${project.build.directory}</directory><includes><include>*.exec</include></includes></fileSet></fileSets>
                            <destFile>${project.build.directory}/jacoco-all.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id><phase>verify</phase><goals><goal>report</goal></goals>
                        <configuration><dataFile>${project.build.directory}/jacoco-all.exec</dataFile></configuration>
                    </execution>
                    <execution>
                        <id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-all.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit></limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
